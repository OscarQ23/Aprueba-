# MongoDB local. No colocar credenciales reales en este archivo versionado.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=aprueba
MONGODB_COLECCION=predicciones

# Almacén de modelos compatible con S3.
AWS_ACCESS_KEY_ID=reemplazar_en_entorno_local
AWS_SECRET_ACCESS_KEY=reemplazar_en_entorno_local
AWS_REGION=us-east-1
S3_BUCKET_MODELOS=aprueba-modelos
# S3_ENDPOINT_URL=http://localhost:9000

# Indicadores agregados del comité de riesgo.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=aprueba
MYSQL_PASSWORD=reemplazar_en_entorno_local
MYSQL_DATABASE=aprueba
